# Sandbox-only standalone receiver. NEVER use for RecordPathAI production.
# No production server.js, templates, court records, or Lob integration packaged.
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
 && npm install --no-save --ignore-scripts --package-lock=false pg@8 \
 && npm cache clean --force
COPY src/payment-security.js src/packet-sandbox-webhook.js ./src/
COPY tools/run-packet-sandbox-webhook.mjs ./tools/
USER node
EXPOSE 8080
CMD ["node","tools/run-packet-sandbox-webhook.mjs"]
