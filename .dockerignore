# Avoid leaking build credentials or unnecessary local files in the image
.git
.github
node_modules
**/node_modules
.env
.env.*
gha-creds-*.json
**/gha-creds-*.json
*.pem
*.key
*.p12
*.pfx
.gcloud
tests
coverage
.wave1-agent-input
.wave1-agent-output
npm-debug.log*
.DS_Store

# Never commit or package real county court exports, applicant lists or private ingest manifests.
private-exports/
private-records/
records-private/
*.jsonl
*.dat
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.sqlite
*.db
