{
  "name": "recordpathai",
  "version": "1.0.0",
  "description": "RecordPathAI Cloud Run deployment",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "crawl:forms": "node tools/form-crawler.js",
    "crawl:forms:ohio:tier1": "node tools/form-crawler.js --state=OH --tier=tier1",
    "crawl:forms:ohio:tier1:apply": "node tools/form-crawler.js --state=OH --tier=tier1 --apply",
    "validate:auth": "node tools/validate-auth-flow.js",
    "validate:i18n": "node tools/validate-i18n.js",
    "test:security": "node --test tests/*.mjs",
    "forms:candidates:dry": "node tools/prepare-form-candidates.mjs --state=OH --limit=25",
    "forms:candidates:wood": "node tools/prepare-form-candidates.mjs --state=OH --county=wood --wood --limit=25",
    "forms:candidates:write": "node tools/prepare-form-candidates.mjs --state=OH --limit=25 --write"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "pdfjs-dist": "^4.10.38",
    "stripe": "^14.25.0"
  },
  "engines": {
    "node": "22"
  }
}
